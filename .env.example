# Порт, на якому запускається API
PORT=8080

# Шлях до файлу бази даних SQLite
DB_PATH=api.db

# Секретний ключ для підпису JWT-токенів. ОБОВ'ЯЗКОВО.
# Згенеруйте свій: openssl rand -hex 32
JWT_SECRET=

# З яких адрес фронтенду дозволені запити (через кому, без пробілів)
CORS_ALLOWED_ORIGINS=http://localhost:5173
